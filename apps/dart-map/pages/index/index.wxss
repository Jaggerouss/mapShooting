.home-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1;
}

.content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.app-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 56rpx;
}

.start-btn {
  width: 420rpx;
  background: #e24b4a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  line-height: 88rpx;
}

.recent-row {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.preset-row {
  position: absolute;
  bottom: 230rpx;
  left: 0;
  right: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.section-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.preset-list {
  display: flex;
  gap: 12rpx;
}

.preset-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.preset-thumb {
  width: 100%;
  height: 90rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.preset-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.recent-scroll {
  white-space: nowrap;
  width: 100%;
  display: block;
}

.recent-thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}
