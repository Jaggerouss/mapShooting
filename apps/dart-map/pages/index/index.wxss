.home-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.35);
  z-index: 1;
}

.content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.app-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 16rpx;
}

.app-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 56rpx;
  text-align: center;
}

.region-picker {
  width: 420rpx;
  margin-bottom: 20rpx;
}

.region-picker-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 44rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
}

.region-picker-arrow {
  font-size: 22rpx;
}

.start-btn {
  width: 420rpx;
  background: #e24b4a;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  line-height: 88rpx;
}

/* ==================== 探索度 ==================== */

.explore-card {
  width: 420rpx;
  margin: 12rpx 0 32rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.explore-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.explore-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.explore-pct {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.explore-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
  margin-bottom: 10rpx;
}

.explore-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #ffb457, #e24b4a);
  transition: width 400ms ease-out;
}

.explore-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}
