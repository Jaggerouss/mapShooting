<view class="home-page">
  <image
    class="bg-image"
    src="/assets/images/home_bg.jpg"
    mode="aspectFill"
  ></image>

  <view class="mask"></view>

  <view class="content">
    <text class="app-title">跟着Jagger去旅行</text>
    <text class="app-subtitle">-</text>

    <picker
      class="region-picker"
      mode="selector"
      range="{{regionList}}"
      range-key="name"
      value="{{regionIndex}}"
      bindchange="onRegionChange"
    >
      <view class="region-picker-inner">
        <text>范围：{{regionList[regionIndex].name}}</text>
        <text class="region-picker-arrow">▾</text>
      </view>
    </picker>

    <button class="start-btn" bindtap="onStartGame" style="position: relative; left: 0rpx; top: 2rpx">开始游戏</button>
  </view>
</view>
