.page {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx 24rpx 0;
}

.top-bar {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
}

.music-btn {
  font-size: 40rpx;
  padding: 8rpx 16rpx;
}

.map-wrap {
  flex: 1;
  min-height: 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.map-view {
  width: 100%;
  height: 100%;
}

.control-area {
  flex-shrink: 0;
  padding: 20rpx 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
}

.throw-btn {
  width: 100%;
  background: #e24b4a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  border-radius: 44rpx;
}

.result-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.18);
  z-index: 999;
  overflow: hidden;
}

.result-handle {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0;
}

.result-panel.is-collapsed .result-handle {
  padding: 12rpx 0;
}

.result-body {
  padding: 0 40rpx 40rpx;
  text-align: center;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.result-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.result-coord {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 30rpx;
}

.again-btn {
  background: #e24b4a;
  color: #fff;
}
