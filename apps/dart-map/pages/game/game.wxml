<view class="page">
  <view class="top-bar">
    <text class="title">飞镖选地方</text>
    <view class="top-bar-actions">
      <view wx:if="{{mapSrc}}" class="change-map-btn" bindtap="changeMap">
        <text>更换地图</text>
      </view>
      <view class="music-btn" bindtap="toggleMusic">
        <text>{{musicOn ? '🔊' : '🔇'}}</text>
      </view>
    </view>
  </view>

  <!-- 未上传地图时显示上传按钮 -->
  <view wx:if="{{!mapSrc}}" class="upload-box" bindtap="chooseMap">
    <text>点击上传地图图片</text>
  </view>

  <!-- 地图 canvas（静态图片模式，SVG/JPG 均支持） -->
  <view wx:else class="canvas-wrap" style="height: {{canvasHeight}}px;">
    <canvas
      type="2d"
      id="mapCanvas"
      class="map-canvas"
      style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    ></canvas>
  </view>

  <!-- 控制区：力度 + 角度摇杆 + 投掷按钮 -->
  <view wx:if="{{mapSrc}}" class="control-area">
    <view class="power-row">
      <text class="label">力度 {{power}}%</text>
      <slider
        min="0" max="100" value="{{power}}"
        activeColor="#e24b4a"
        bindchanging="onPowerChanging"
        bindchange="onPowerChange"
      />
    </view>

    <view class="joystick-row">
      <view
        class="joystick-base"
        bindtouchstart="onStickStart"
        bindtouchmove="onStickMove"
        bindtouchend="onStickEnd"
      >
        <view
          class="joystick-knob"
          style="transform: translate({{knobX}}px, {{knobY}}px);"
        ></view>
      </view>
      <text class="hint">拖动摇杆确定方向</text>
      <button class="throw-btn" bindtap="throwDart" disabled="{{throwing}}">投掷</button>
    </view>
  </view>

  <!-- 结果弹层 -->
  <view wx:if="{{showResult}}" class="result-mask" bindtap="closeResult">
    <view class="result-card" catchtap="noop">
      <text class="result-title">命中！</text>
      <text class="result-desc">{{resultText}}</text>
      <button class="again-btn" bindtap="throwAgain">再投一次</button>
    </view>
  </view>
</view>
