<view class="page">
  <view class="top-bar">
    <text class="title">选 · {{regionName}}</text>
    <view wx:if="{{false}}" class="music-btn" bindtap="toggleMusic">
      <text>{{musicOn ? '🔊' : '🔇'}}</text>
    </view>
  </view>

  <view class="map-wrap">
    <map
      id="map"
      class="map-view"
      latitude="{{mapCenter.latitude}}"
      longitude="{{mapCenter.longitude}}"
      scale="{{mapScale}}"
      markers="{{markers}}"
      binderror="onMapError"
      bindabilityfail="onMapAbilityFail"
      bindupdated="onMapUpdated"
    ></map>
  </view>

  <view class="control-area">
    <text class="hint">限定范围：{{regionName}}</text>
    <button class="throw-btn" bindtap="throwDart" disabled="{{throwing}}">
      {{throwing ? '投掷中...' : '投掷飞镖'}}
    </button>
  </view>

  <!-- 结果面板：贴底展示，不遮挡地图，可收起查看命中位置 -->
  <view wx:if="{{showResult}}" class="result-panel {{resultCollapsed ? 'is-collapsed' : ''}}">
    <view class="result-handle" bindtap="toggleResultCard">
      <text>{{resultCollapsed ? '查看结果 ▲' : '收起看地图 ▼'}}</text>
    </view>
    <view wx:if="{{!resultCollapsed}}" class="result-body">
      <text class="result-title">命中！</text>
      <text class="result-desc">{{resultText}}</text>
      <text class="result-coord">{{resultCoord}}</text>
      <button class="again-btn" bindtap="throwAgain">再投一次</button>
    </view>
  </view>
</view>

